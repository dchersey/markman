# Local prototype recipe: run makepkg from packaging/arch in this checkout.
pkgname=markman
pkgver=0.1.4
pkgrel=1
pkgdesc='A small, full-width Markdown viewer'
arch=('any')
url='https://github.com/dchersey/markman'
license=('GPL-3.0-only')
depends=('python' 'python-gobject' 'gtk4' 'webkitgtk-6.0')

package() {
  DESTDIR="$pkgdir" PREFIX=/usr bash "$startdir/../../scripts/install-linux.sh"
}
